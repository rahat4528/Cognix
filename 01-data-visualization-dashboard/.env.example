# Environment Configuration for Data Visualization Dashboard

# Application
APP_NAME=Cognix Data Visualization Dashboard
ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Security & Secrets
JWT_SECRET=cognix_dev_jwt_secret_key_production_change_in_env_32chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL for metadata; SQLite supported for zero-setup local dev/tests)
# Local development default uses SQLite for instant out-of-the-box operation:
DATABASE_URL=sqlite+aiosqlite:///./cognix_dataviz_dev.db
# Production PostgreSQL URL:
# DATABASE_URL=postgresql+asyncpg://cognix_user:cognix_secure_password@localhost:5432/cognix_dataviz_db

# Redis (Caching & Task Queue)
REDIS_URL=redis://localhost:6379/0

# Storage (local filesystem or s3/minio)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage/datasets
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=cognix_minio_admin
S3_SECRET_KEY=cognix_minio_secret_key
S3_BUCKET=cognix-dataviz-datasets

# Security & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
MAX_UPLOAD_SIZE_BYTES=104857600
SQL_QUERY_TIMEOUT_SECONDS=15
SQL_MAX_RESULT_ROWS=10000
