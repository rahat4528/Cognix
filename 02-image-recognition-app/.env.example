# Environment Configuration: Image Recognition App

# Application
APP_NAME=Cognix Image Recognition App
ENV=development
DEBUG=True

# Security
JWT_SECRET=cognix_cv_jwt_secret_key_change_in_production_32chars!
INTERNAL_SERVICE_KEY=cognix_internal_cv_secret_token_32chars_min!
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL with pgvector in prod; SQLite fallback for local dev/testing)
DATABASE_URL=sqlite+aiosqlite:///./cognix_image_dev.db
# DATABASE_URL=postgresql+asyncpg://cognix_cv_user:cognix_cv_secure_pass@localhost:5433/cognix_image_recognition_db

# Redis
REDIS_URL=redis://localhost:6380/0

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage/images

# Microservice Routing
INFERENCE_SERVICE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Vision Inference Limits & Guardrails
CONFIDENCE_THRESHOLD_UNCERTAIN=0.20
DETECTION_CONFIDENCE_THRESHOLD=0.30
DETECTION_NMS_THRESHOLD=0.45
MAX_IMAGE_MEGAPIXELS=25
MAX_UPLOAD_SIZE_BYTES=20971520
CAMERA_MAX_FPS=5
